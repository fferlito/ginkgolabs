{
  "expo": {
    "name": "MushroomRadar",
    "slug": "mushroom-radar",
    "scheme": "mushroomradar",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0E0C"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mushroomradar.app",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "Show your location on the mushroom map.",
        "NSCameraUsageDescription": "Take a photo to identify a mushroom.",
        "NSPhotoLibraryUsageDescription": "Attach a photo to your observation.",
        "CFBundleLocalizations": [
          "be",
          "bg",
          "bs",
          "ca",
          "cs",
          "cy",
          "da",
          "de",
          "el",
          "en",
          "es",
          "et",
          "eu",
          "fi",
          "fo",
          "fr",
          "ga",
          "gd",
          "gl",
          "hr",
          "hu",
          "is",
          "it",
          "lb",
          "lt",
          "lv",
          "mk",
          "mt",
          "nb",
          "nl",
          "pl",
          "pt",
          "rm",
          "ro",
          "ru",
          "sk",
          "sl",
          "sq",
          "sr",
          "sv",
          "tr",
          "uk"
        ]
      }
    },
    "android": {
      "package": "com.mushroomradar.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#0A0E0C",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-status-bar",
      [
        "@clerk/expo",
        {
          "appleSignIn": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Show your location on the mushroom map."
        }
      ],
      [
        "@rnmapbox/maps",
        {
          "RNMapboxMapsVersion": "11.23.1"
        }
      ],
      "expo-web-browser",
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false,
          "hidden": true,
          "style": "light"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Take a photo to identify a mushroom."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Attach a photo to your observation."
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": [
              "be",
